{
  "name": "yiyi-shipping-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"app\" \"components\" \"lib\" \"tests\" \"*.ts\" \"*.mjs\" \"package.json\" \"tsconfig.json\"",
    "format:check": "prettier --check \"app\" \"components\" \"lib\" \"tests\" \"*.ts\" \"*.mjs\" \"package.json\" \"tsconfig.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "googleapis": "^189.0.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
